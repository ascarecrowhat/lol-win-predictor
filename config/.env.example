# Copy to config/.env and fill in. config/.env is gitignored.

RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Platform routing (league, spectator, summoner): euw1 na1 kr eun1 br1 ...
RIOT_PLATFORM=euw1
# Regional routing (account, match): europe americas asia sea
RIOT_REGION=europe

# 420 = ranked solo/duo
QUEUE_ID=420

# LOOKBACK_DAYS is the real filter: only match IDs newer than this are requested,
# which keeps the dataset inside a couple of patches automatically.
LOOKBACK_DAYS=21
# Optional extra hard floor on patch, e.g. 26.18. Blank = no floor.
MIN_PATCH=

# Dev key: 20 req/s and 100 req/2min. Production keys are much higher.
APP_RATE_LIMITS=20:1,100:120

DATA_DIR=data
DB_PATH=data/lol.duckdb
MODEL_DIR=models
